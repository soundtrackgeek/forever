{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Forever",
  "version": "0.0.38",
  "identifier": "com.soundtrackgeek.forever",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Forever",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "center": true,
        "decorations": false,
        "resizable": true,
        "fullscreen": false,
        "shadow": true,
        "theme": "Dark",
        "backgroundColor": "#070a13"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost https://coverartarchive.org https://archive.org https://*.archive.org; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "category": "Music",
    "shortDescription": "A modern desktop client for the Soulseek network.",
    "longDescription": "Forever is a fast, polished, modern desktop client for searching and sharing music on the Soulseek network.",
    "copyright": "Copyright © 2026 soundtrackgeek",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY0MERGNEY5Njc0MDEwNTYKUldSV0VFQm4rZlFOWkl2ZWtsTmZpUU1od09iZlVSektDM1hUZWRSU0dRZ2tOVmRDcjQ3ZGN1cFQK",
      "endpoints": [
        "https://github.com/soundtrackgeek/forever/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
